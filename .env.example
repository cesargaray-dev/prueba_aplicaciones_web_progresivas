# Database (Neon PostgreSQL)
DB_URL=jdbc:postgresql://<host>/<database>?sslmode=require
DB_USERNAME=<db_username>
DB_PASSWORD=<db_password>

# GestoPago (PuntoRed)
GESTOPAGO_API_URL=https://gestopago.portalventas.net
GESTOPAGO_API_TOKEN=
GESTOPAGO_API_KEY=<gestopago_api_key>
GESTOPAGO_SECRET_KEY=<gestopago_aes_secret_key_base64>
GESTOPAGO_IV=<gestopago_aes_iv_base64>
GESTOPAGO_UNIDAD=<gestopago_unidad>
GESTOPAGO_AUTH_URL=https://gestopago.portalventas.net
GESTOPAGO_ID_DISTRIBUIDOR=<gestopago_id_distribuidor>
GESTOPAGO_CODIGO_DISPOSITIVO=<gestopago_codigo_dispositivo>
GESTOPAGO_AUTH_PASSWORD=<gestopago_auth_password>

# Brevo Email API
BREVO_API_URL=https://api.brevo.com
BREVO_API_KEY=<brevo_api_key>
BREVO_SENDER_EMAIL=<sender_email>

# Redis & Runtime
APP_REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
PORT=10000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8085,http://localhost:3000
APP_SESSION_TTL_SECONDS=300
APP_EXPOSE_OTP_IN_RESPONSE=false
APP_ONBOARDING_SALDO_INICIAL=200.00

# SonarQube (CLI / Gradle)
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=<sonar_token>
